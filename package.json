{
  "name": "realtime-meeting-copilot",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "predev": "node scripts/cleanup-legacy.js",
    "dev": "next dev",
    "prebuild": "node scripts/cleanup-legacy.js",
    "build": "next build",
    "start": "next start",
    "prelint": "node scripts/cleanup-legacy.js",
    "lint": "next lint",
    "pretypecheck": "node scripts/cleanup-legacy.js",
    "typecheck": "tsc --noEmit",
    "fix": "biome format --write .",
    "verify-setup": "node scripts/verify-setup.js",
    "smoke": "node scripts/smoke-test.js",
    "validate": "npm run typecheck && npm run smoke && npm run build",
    "cleanup:legacy": "node scripts/cleanup-legacy.js",
    "clean:build": "node scripts/clean-build.js",
    "rebuild": "npm run clean:build && npm run build"
  },
  "dependencies": {
    "@google/genai": "2.18.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.0",
    "@vercel/analytics": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "lucide-react": "^0.341.0",
    "next": "^16.3.3",
    "pdf-parse": "1.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.3",
    "@types/node": "^20.14.14",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^16.3.3",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.9",
    "typescript": "^5.5.4"
  }
}
