# Speech-to-text
# Used server-side to mint short-lived JWTs for browser WebSocket sessions; Member-or-higher permission is required.
DEEPGRAM_API_KEY="your-deepgram-api-key"

# Primary answer provider: gemini | cerebras | groq
LLM_PROVIDER="gemini"
LLM_MAX_OUTPUT_TOKENS="420" # global cap; V9 lowers it per request for brief answers
LLM_CONNECT_TIMEOUT_MS="8000"
CANDIDATE_CONTEXT_MAX_CHARS="4200" # top relevant project evidence is protected inside this budget
# Strong local Q&A matches let us use a smaller candidate-validation context.
CANDIDATE_CONTEXT_STRONG_QA_CHARS="1800"
QA_STRONG_MATCH_SCORE="30"
CANDIDATE_NOTES_MAX_CHARS="2000"
RECENT_CONTEXT_MAX_CHARS="2600"
# Local prepared Q&A matching; no network call is added.
QA_MATCH_LIMIT="2"
QA_MATCH_MIN_SCORE="8"
QA_CONTEXT_MAX_CHARS="2400"

# Gemini (default quality baseline)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_API_VERSION="v1"
GEMINI_THINKING_LEVEL="minimal"
# standard | priority. Priority costs more but is designed for lower/predictable latency.
GEMINI_SERVICE_TIER="standard"
# Optional immediate fallback for transient 429/5xx only. No artificial retry sleep.
GEMINI_FALLBACK_MODEL="gemini-3.5-flash-lite"
MEMORY_MODEL="gemini-3.5-flash-lite"
KNOWLEDGE_EXTRACTION_MODEL="gemini-3.6-flash"

# Optional alternative primary/fallback providers for latency benchmarking
CEREBRAS_API_KEY=""
CEREBRAS_MODEL="gpt-oss-120b"
# CEREBRAS_API_URL="https://api.cerebras.ai/v1/chat/completions"
# Prompt-cache routing requires account enablement on Cerebras.
CEREBRAS_PROMPT_CACHE_ENABLED="false"

GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
# GROQ_API_URL="https://api.groq.com/openai/v1/chat/completions"
GROQ_SERVICE_TIER=""

# Example: LLM_FALLBACK_PROVIDER="cerebras"
LLM_FALLBACK_PROVIDER=""

# Optional fresh web lookup; skipped for normal interview/technical questions.
TAVILY_API_KEY=""
WEB_SEARCH_TIMEOUT_MS="1200"
